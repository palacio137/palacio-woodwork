---
import { company } from '../data/site';
import { useContent } from '../i18n/content';
import { getLang, path, type Lang } from '../i18n/routes';

interface Props {
  variant?: 'default' | 'services' | 'projects';
}
const { variant = 'default' } = Astro.props;

const lang: Lang = getLang(Astro.url.pathname);
const t = useContent(lang);

const copy = {
  default: { title: t.band.title, body: t.band.body },
  services: { title: t.band.servicesTitle, body: t.band.servicesBody },
  projects: { title: t.band.projectsTitle, body: t.band.projectsBody },
}[variant];
---

<section class="band">
  <div class="band__bg" aria-hidden="true">
    <img src="/img/craft-shop.jpg" alt="" loading="lazy" decoding="async" />
  </div>

  <div class="shell band__inner" data-reveal>
    <div>
      <h2 class="display-md band__title">{copy.title}</h2>
      <p class="band__body">{copy.body}</p>
    </div>

    <div class="btn-row band__actions">
      <a class="btn btn--oak" href={path('contact', lang)}>{t.common.quote}</a>
      <a class="btn btn--outline-light" href={company.phoneHref}>
        {t.common.call} {company.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    background: var(--forest);
    color: rgba(255, 255, 255, 0.76);
    overflow: hidden;
  }

  .band__bg { position: absolute; inset: 0; z-index: -2; }
  .band__bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.28; }

  .band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(14, 31, 25, 0.95) 20%, rgba(27, 58, 47, 0.78) 100%);
  }

  .band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .band__title { color: #fff; max-width: 20ch; }

  .band__body {
    margin-top: 0.875rem;
    max-width: 48ch;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.74);
  }

  .band__actions { flex: none; }
</style>
