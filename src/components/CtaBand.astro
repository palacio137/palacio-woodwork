---
import { company } from '../data/site';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Ready to start?',
  body = 'Send photos of the space and we will tell you honestly what it takes.',
} = Astro.props;
---

<section class="band">
  <div class="band__bg" aria-hidden="true">
    <img src="/img/craft-shop.jpg" alt="" loading="lazy" decoding="async" />
  </div>

  <div class="shell band__inner" data-reveal>
    <div>
      <h2 class="display-md band__title">{title}</h2>
      <p class="band__body">{body}</p>
    </div>

    <div class="btn-row band__actions">
      <a class="btn btn--oak" href="/contact">Request a quote</a>
      <a class="btn btn--outline-light" href={company.phoneHref}>Call {company.phone}</a>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    background: var(--forest);
    color: rgba(255, 255, 255, 0.76);
    overflow: hidden;
  }

  .band__bg { position: absolute; inset: 0; z-index: -2; }
  .band__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
  }

  .band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(14, 31, 25, 0.95) 20%, rgba(27, 58, 47, 0.78) 100%);
  }

  .band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .band__title { color: #fff; max-width: 18ch; }

  .band__body {
    margin-top: 0.875rem;
    max-width: 46ch;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.74);
  }

  .band__actions { flex: none; }
</style>
