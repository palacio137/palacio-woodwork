---
---
<header class="header" id="siteHeader">
  <div class="header-inner container">
    <a href="#home" class="logo" aria-label="Palacio Woodwork LLC Home">
      <img src="/logo.jpg" alt="Palacio Woodwork LLC" class="logo-img" width="44" height="44" />
      <span class="logo-text">Palacio <strong>Woodwork</strong></span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#gallery">Gallery</a>
      <a href="#testimonials">Reviews</a>
      <a href="#contact" class="btn-nav nav-cta">Free Estimate</a>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu" aria-expanded="false" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobileNav" aria-hidden="true">
    <a href="#services" class="mobile-nav-link">Services</a>
    <a href="#about" class="mobile-nav-link">About</a>
    <a href="#gallery" class="mobile-nav-link">Gallery</a>
    <a href="#testimonials" class="mobile-nav-link">Reviews</a>
    <a href="#contact" class="mobile-nav-link mobile-cta">Get a Free Estimate</a>
  </div>
</header>

<style>
.logo-img {
  width: 44px;
  height: 44px;
  object-fit: contain;
  border-radius: 4px;
  flex-shrink: 0;
}
</style>
