---
import Brand from './Brand.astro';
import { company } from '../data/site';
import { useContent } from '../i18n/content';
import { getLang, path, counterpart, type Lang } from '../i18n/routes';

const lang: Lang = getLang(Astro.url.pathname);
const t = useContent(lang);
const here = Astro.url.pathname;

const isActive = (target: string) => here === target || `${here}/` === target;
---

<div class="topbar">
  <div class="shell topbar__inner">
    <p class="topbar__tag">{t.craft.headingLead} {t.craft.headingEm}</p>
    <div class="topbar__links">
      <a href={company.instagram} target="_blank" rel="noopener">{company.instagramHandle}</a>
      <span aria-hidden="true">·</span>
      <span>{company.city}, {company.state}</span>
    </div>
  </div>
</div>

<header class="header" data-header>
  <div class="shell header__inner">
    <Brand size="md" href={path('home', lang)} />

    <nav class="nav" aria-label="Main">
      {t.nav.map((item) => (
        <a
          href={path(item.key, lang)}
          class:list={['nav__link', { 'is-active': isActive(path(item.key, lang)) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header__actions">
      <div class="langs" role="group" aria-label={t.common.langLabel}>
        <a
          href={counterpart(here, 'en')}
          class:list={['langs__opt', { 'is-active': lang === 'en' }]}
          data-lang-pick="en"
          hreflang="en"
          lang="en"
        >EN</a>
        <span class="langs__sep" aria-hidden="true"></span>
        <a
          href={counterpart(here, 'es')}
          class:list={['langs__opt', { 'is-active': lang === 'es' }]}
          data-lang-pick="es"
          hreflang="es"
          lang="es"
        >ES</a>
      </div>

      <a class="header__call" href={company.phoneHref} aria-label={`${t.common.call} ${company.phone}`}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
      </a>

      <a class="btn header__cta" href={path('contact', lang)}>{t.common.quote}</a>
    </div>
  </div>
</header>

<style>
  /* ------------------------------------------------------------ topbar */
  .topbar {
    background: var(--forest-900);
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.75rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 38px;
  }
  .topbar__tag {
    display: none;
    font-style: italic;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.75);
  }
  @media (min-width: 860px) { .topbar__tag { display: block; } }

  .topbar__links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    white-space: nowrap;
  }
  .topbar__links a:hover { color: var(--oak); }

  /* ------------------------------------------------------------ header */
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(255, 255, 255, 0.93);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.3s var(--ease);
  }
  .header.is-stuck { box-shadow: 0 10px 30px -18px rgba(20, 32, 27, 0.5); }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 70px;
  }

  /* --------------------------------------------------------------- nav */
  .nav { display: none; align-items: center; gap: 2rem; }
  @media (min-width: 1000px) { .nav { display: flex; } }

  .nav__link {
    position: relative;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink);
    padding-block: 0.25rem;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--oak);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .nav__link:hover::after,
  .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link.is-active { color: var(--forest); }

  /* ----------------------------------------------------------- actions */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* language switcher */
  .langs {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }
  .langs__opt {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .langs__opt:hover { color: var(--forest); }
  .langs__opt.is-active { color: var(--forest); }
  .langs__sep {
    width: 1px;
    height: 12px;
    background: var(--line-strong);
  }

  /* call: icon only, per brand preference */
  .header__call {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: var(--forest);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease),
                background 0.25s var(--ease);
  }
  .header__call:hover {
    background: var(--forest);
    border-color: var(--forest);
    color: #fff;
  }

  .header__cta { display: none; }
  @media (min-width: 1000px) { .header__cta { display: inline-flex; } }
</style>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    if (header) {
      const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // An explicit pick wins over browser-language detection from then on.
    document.querySelectorAll('[data-lang-pick]').forEach((el) => {
      el.addEventListener('click', () => {
        try {
          localStorage.setItem('pw-lang', el.getAttribute('data-lang-pick'));
        } catch (_) {}
      });
    });
  })();
</script>
