---
import Brand from './Brand.astro';
import { company, nav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === `${href}/`;
---

<div class="topbar">
  <div class="shell topbar__inner">
    <p class="topbar__tag">{company.promise}</p>
    <div class="topbar__links">
      <a href={company.instagram} target="_blank" rel="noopener">{company.instagramHandle}</a>
      <span aria-hidden="true">·</span>
      <span>{company.city}, {company.state}</span>
    </div>
  </div>
</div>

<header class="header" data-header>
  <div class="shell header__inner">
    <Brand size="md" />

    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={company.phoneHref} aria-label={`Call ${company.phone}`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
        <span class="header__phone-num">{company.phone}</span>
      </a>
      <a class="btn header__cta" href="/contact">Request a quote</a>

      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="visually-hidden">Menu</span>
        <span class="burger__bar"></span>
        <span class="burger__bar"></span>
      </button>
    </div>
  </div>

  <div class="drawer" id="mobile-nav" data-drawer hidden>
    <nav class="drawer__nav" aria-label="Mobile">
      <a href="/" class:list={['drawer__link', { 'is-active': isActive('/') }]}>Home</a>
      {nav.map((item) => (
        <a href={item.href} class:list={['drawer__link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="drawer__foot">
      <a class="btn btn--oak" href={company.phoneHref}>Call {company.phone}</a>
    </div>
  </div>
</header>

<style>
  /* ------------------------------------------------------------ topbar */
  .topbar {
    background: var(--forest-900);
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 38px;
  }
  .topbar__tag {
    display: none;
    font-style: italic;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.75);
  }
  @media (min-width: 760px) { .topbar__tag { display: block; } }

  .topbar__links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    white-space: nowrap;
  }
  .topbar__links a:hover { color: var(--oak); }

  /* ------------------------------------------------------------ header */
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.3s var(--ease);
  }
  .header.is-stuck { box-shadow: 0 10px 30px -18px rgba(20, 32, 27, 0.5); }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 74px;
  }

  /* --------------------------------------------------------------- nav */
  .nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }
  @media (min-width: 1000px) { .nav { display: flex; } }

  .nav__link {
    position: relative;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink);
    padding-block: 0.25rem;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--oak);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .nav__link:hover::after,
  .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link.is-active { color: var(--forest); }

  /* ----------------------------------------------------------- actions */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Always reachable: icon-only tap target on phones, full number from 640px */
  .header__phone {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--forest);
    white-space: nowrap;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }
  .header__phone:hover { color: var(--oak-600); border-color: var(--oak); }
  .header__phone-num { display: none; }

  @media (min-width: 640px) {
    .header__phone {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      width: auto;
      height: auto;
      border: 0;
    }
    .header__phone-num { display: inline; }
  }

  .header__cta { display: none; }
  @media (min-width: 1000px) { .header__cta { display: inline-flex; } }

  /* ------------------------------------------------------------ burger */
  .burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }
  @media (min-width: 1000px) { .burger { display: none; } }

  .burger__bar {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--ink);
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }
  .burger[aria-expanded='true'] .burger__bar:first-child { transform: translateY(3.75px) rotate(45deg); }
  .burger[aria-expanded='true'] .burger__bar:last-child  { transform: translateY(-3.75px) rotate(-45deg); }

  /* ------------------------------------------------------------ drawer */
  .drawer {
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding: 1rem var(--gutter) 1.75rem;
  }
  @media (min-width: 1000px) { .drawer { display: none !important; } }

  .drawer__nav { display: flex; flex-direction: column; }

  .drawer__link {
    padding: 0.9375rem 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .drawer__link.is-active { color: var(--oak-600); }

  .drawer__foot { margin-top: 1.5rem; }
  .drawer__foot .btn { width: 100%; }
</style>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    const burger = document.querySelector('[data-burger]');
    const drawer = document.querySelector('[data-drawer]');

    if (burger && drawer) {
      burger.addEventListener('click', () => {
        const open = burger.getAttribute('aria-expanded') === 'true';
        burger.setAttribute('aria-expanded', String(!open));
        drawer.hidden = open;
      });
    }

    if (header) {
      const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  })();
</script>
