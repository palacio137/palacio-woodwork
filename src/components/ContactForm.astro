---
import { company } from '../data/site';
import { useContent } from '../i18n/content';
import { getLang, type Lang } from '../i18n/routes';

const lang: Lang = getLang(Astro.url.pathname);
const t = useContent(lang);
const L = t.contact.labels;
---

<section class="section contact" id="quote">
  <div class="shell contact__grid">
    <!-- ---------------------------------------------------------- info -->
    <div class="contact__info" data-reveal>
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h2 class="display-lg contact__title">{t.contact.heading}</h2>
      <p class="lede contact__lede">{t.contact.lede}</p>

      <ul class="contact__list">
        <li>
          <span class="contact__label">{L.phone}</span>
          <a class="contact__value" href={company.phoneHref}>{company.phone}</a>
        </li>
        <li class="contact__item--wide">
          <span class="contact__label">{L.email}</span>
          <a class="contact__value" href={`mailto:${company.email}`}>{company.email}</a>
        </li>
        <li>
          <span class="contact__label">{L.based}</span>
          <span class="contact__value">{company.city}, {company.state}</span>
        </li>
        <li>
          <span class="contact__label">{L.instagram}</span>
          <a class="contact__value" href={company.instagram} target="_blank" rel="noopener">
            {company.instagramHandle}
          </a>
        </li>
      </ul>
    </div>

    <!-- ---------------------------------------------------------- form -->
    <div class="contact__card" data-reveal style="--reveal-delay:120ms">
      <form class="form" data-quote-form>
        <div class="field">
          <label for="q-name">{L.name}</label>
          <input id="q-name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="q-phone">{L.phoneField}</label>
            <input id="q-phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
          <div class="field">
            <label for="q-city">{L.city}</label>
            <input id="q-city" name="city" type="text" autocomplete="address-level2" />
          </div>
        </div>

        <div class="field">
          <label for="q-service">{L.service}</label>
          <select id="q-service" name="service">
            {t.services.items.map((s) => (<option value={s.title}>{s.title}</option>))}
            <option value={L.other}>{L.other}</option>
          </select>
        </div>

        <div class="field">
          <label for="q-message">{L.details}</label>
          <textarea id="q-message" name="message" rows="4" placeholder={L.detailsPlaceholder}></textarea>
        </div>

        <div class="form__actions">
          <button class="btn btn--oak" type="submit">
            {t.contact.submit}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.6 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6a11.4 11.4 0 0 1-4.4-3.9c-.5-.7-.8-1.5-.8-2.3 0-.8.4-1.5.7-1.8.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6.4.7.9 1.3 1.5 1.8.6.5 1.1.7 1.4.8.2.1.4.1.5-.1l.7-.8c.2-.2.3-.2.5-.1l1.8.9c.2.1.4.2.4.3.1.2.1.6-.1 1.1Z" />
            </svg>
          </button>
          <button class="btn btn--ghost" type="button" data-email-instead>{t.contact.emailInstead}</button>
        </div>

        <p class="form__note">{t.contact.note}</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact { background: var(--paper); }

  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 960px) {
    .contact__grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  }

  .contact__title { margin-top: 1.25rem; max-width: 16ch; }
  .contact__lede { margin-top: 1.25rem; }

  .contact__list {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    display: grid;
    gap: 1.375rem;
  }
  @media (min-width: 560px) {
    .contact__list { grid-template-columns: repeat(2, 1fr); }
    .contact__item--wide { grid-column: 1 / -1; }
  }

  .contact__list li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .contact__label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--oak-600);
  }

  .contact__value {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  a.contact__value:hover { color: var(--oak-600); }

  /* --------------------------------------------------------------- card */
  .contact__card {
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    background: var(--sand);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .form { display: grid; gap: 1.125rem; }

  .field-row { display: grid; gap: 1.125rem; }
  @media (min-width: 520px) { .field-row { grid-template-columns: repeat(2, 1fr); } }

  .field { display: flex; flex-direction: column; gap: 0.4375rem; }

  .field label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.8125rem 0.9375rem;
    font-size: 1rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .field textarea { resize: vertical; min-height: 7rem; }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--forest);
    box-shadow: 0 0 0 3px rgba(27, 58, 47, 0.1);
  }

  .field input::placeholder,
  .field textarea::placeholder { color: var(--muted); }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.375rem;
  }

  .form__note {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.6;
  }
</style>

<script
  is:inline
  define:vars={{
    waNumber: company.whatsapp,
    mailTo: company.email,
    intro: t.contact.messageIntro,
    subject: t.contact.emailSubject,
    L,
  }}
>
  (() => {
    const form = document.querySelector('[data-quote-form]');
    if (!form) return;

    const compose = () => {
      const data = new FormData(form);
      const get = (k) => String(data.get(k) || '').trim();

      const lines = [intro, '', `${L.name}: ${get('name')}`, `${L.phoneField}: ${get('phone')}`];
      if (get('city')) lines.push(`${L.city}: ${get('city')}`);
      lines.push(`${L.service}: ${get('service')}`);
      if (get('message')) lines.push('', `${L.details}:`, get('message'));

      return lines.join('\n');
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      window.open(
        `https://wa.me/${waNumber}?text=${encodeURIComponent(compose())}`,
        '_blank',
        'noopener'
      );
    });

    form.querySelector('[data-email-instead]')?.addEventListener('click', () => {
      if (!form.reportValidity()) return;
      window.location.href =
        `mailto:${mailTo}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(compose())}`;
    });
  })();
</script>
