---
import { company, whatsappLink } from '../data/site';

const chips = [
  'Custom & semi-custom cabinetry',
  'Kitchens, baths & full remodels',
  'Palm Beach County · Statewide · Nationwide',
];
---

<section class="hero">
  <div class="hero__bg">
    <img
      src="/img/hero-kitchen.jpg"
      alt="Luxury kitchen with custom white cabinetry, marble island and brass detailing"
      width="2400"
      height="1351"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="shell hero__inner">
    <p class="eyebrow on-dark" data-reveal>{company.city}, Florida</p>

    <h1 class="display-xl hero__title" data-reveal style="--reveal-delay:80ms">
      <span class="hero__line">Kitchens, cabinetry</span>
      <span class="hero__line">and carpentry</span>
      <em class="hero__line">built to last.</em>
    </h1>

    <p class="lede hero__lede" data-reveal style="--reveal-delay:160ms">
      Palacio Woodwork designs, builds and installs the parts of your home that get
      touched every day — cabinets, stairs, trim and full remodels — with the precision
      of furniture rather than construction.
    </p>

    <div class="btn-row hero__actions" data-reveal style="--reveal-delay:240ms">
      <a class="btn btn--oak" href="/contact">
        Request a quote
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="btn btn--outline-light" href="/projects">See our work</a>
    </div>

    <ul class="hero__chips" data-reveal style="--reveal-delay:320ms">
      {chips.map((chip) => (
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          {chip}
        </li>
      ))}
    </ul>
  </div>

  <a class="hero__call" href={whatsappLink(`Hi Palacio Woodwork, I'd like a quote for my project.`)} target="_blank" rel="noopener">
    <span class="hero__call-label">WhatsApp us</span>
    <span class="hero__call-num">{company.phone}</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(560px, 88vh, 900px);
    background: var(--forest-900);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    animation: heroDrift 24s var(--ease) forwards;
  }

  @keyframes heroDrift {
    from { transform: scale(1.08); }
    to   { transform: scale(1); }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(14, 31, 25, 0.94) 0%, rgba(14, 31, 25, 0.72) 34%, rgba(14, 31, 25, 0.22) 66%, rgba(14, 31, 25, 0.42) 100%),
      linear-gradient(to right, rgba(14, 31, 25, 0.6) 0%, transparent 62%);
  }

  .hero__inner {
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
    color: rgba(255, 255, 255, 0.78);
  }

  .hero__title {
    margin-top: 1.5rem;
    color: #fff;
    max-width: 16ch;
  }
  /* the headline flows as one paragraph on phones, breaks to fixed lines above */
  .hero__line { display: inline; }
  @media (min-width: 560px) { .hero__line { display: block; } }
  .hero__title em {
    font-style: italic;
    color: var(--oak);
  }

  .hero__lede {
    margin-top: 1.75rem;
    color: rgba(255, 255, 255, 0.76);
    max-width: 52ch;
  }

  .hero__actions { margin-top: 2.25rem; }

  .hero__chips {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .hero__chips li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.7);
  }
  .hero__chips svg { color: var(--oak); flex: none; }

  /* floating WhatsApp / phone card */
  .hero__call {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(3.5rem, 9vw, 6.5rem);
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.125rem 1.5rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .hero__call:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--oak);
  }
  @media (min-width: 1100px) { .hero__call { display: flex; } }

  .hero__call-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--oak);
  }
  .hero__call-num {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: #fff;
  }
</style>
