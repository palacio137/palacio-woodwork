---
---
<section class="hero" id="home" aria-label="Hero">
  <div class="hero-left">

    <div class="hero-eyebrow">
      <span class="hero-eyebrow-line"></span>
      <span>South Florida's Premier Craftsmen</span>
    </div>

    <h1 class="hero-title">
      Crafting spaces<br />that <em>last</em>
    </h1>

    <p class="hero-sub">
      Custom woodwork, kitchen & bathroom renovations, cabinetry,
      and complete interior remodeling across South Florida.
    </p>

    <div class="hero-actions">
      <a href="#contact" class="btn-pill btn-pill-solid">Get a Quote →</a>
      <a href="#gallery" class="btn-pill btn-pill-outline">View Our Work</a>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-num">20+</span>
        <span class="hero-stat-label">Years Experience</span>
      </div>
      <div class="hero-stat-sep"></div>
      <div class="hero-stat">
        <span class="hero-stat-num">500+</span>
        <span class="hero-stat-label">Projects Completed</span>
      </div>
      <div class="hero-stat-sep"></div>
      <div class="hero-stat">
        <span class="hero-stat-num">5★</span>
        <span class="hero-stat-label">Client Satisfaction</span>
      </div>
    </div>
  </div>

  <div class="hero-right" aria-hidden="true">
    <div class="hero-img-placeholder">
      <svg width="52" height="52" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="8" y="8" width="48" height="48" rx="4" stroke="currentColor" stroke-width="2" fill="none" opacity="0.2"/>
        <circle cx="24" cy="26" r="6" stroke="currentColor" stroke-width="2" fill="none" opacity="0.25"/>
        <path d="M8 44 L22 30 L32 40 L40 32 L56 48" stroke="currentColor" stroke-width="2" fill="none" opacity="0.25" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Add a project photo here</span>
    </div>
    <div class="hero-badge-float">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Licensed & Insured
    </div>
  </div>
</section>

<style>
/* ─── HERO ──────────────────────────────────────── */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 100svh;
}

/* Left — dark panel */
.hero-left {
  background: #111310;
  color: #f0ede8;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4.5rem);
  gap: 0;
  position: relative;
}

/* Eyebrow */
.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-gold);
  margin-bottom: 1.75rem;
}
.hero-eyebrow-line {
  display: block;
  width: 28px;
  height: 1.5px;
  background: var(--color-gold);
  flex-shrink: 0;
}

/* Big Mona Sans headline — Construktion style */
.hero-title {
  font-family: var(--font-display);
  font-size: var(--text-hero);   /* clamp 56–90px */
  font-weight: 700;
  line-height: 1.04;
  letter-spacing: -0.03em;
  color: #ffffff;
  margin-bottom: 1.75rem;
}

/* Italic word uses gold — same Mona Sans, italic style */
.hero-title em {
  font-style: italic;
  font-weight: 700;
  color: var(--color-gold);
}

/* Sub */
.hero-sub {
  font-size: clamp(0.9rem, 1.1vw, 1.05rem);
  font-weight: 400;
  color: rgba(240,237,232,0.55);
  line-height: 1.65;
  margin-bottom: 2.25rem;
  max-width: 42ch;
  letter-spacing: 0em;
}

/* Actions */
.hero-actions {
  display: flex;
  gap: 0.875rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

/* Stats */
.hero-stats {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(255,255,255,0.08);
  flex-wrap: wrap;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.hero-stat-num {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 2.5vw, 2.5rem);
  font-weight: 700;
  color: var(--color-gold);
  line-height: 1;
  letter-spacing: -0.03em;
}

.hero-stat-label {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(240,237,232,0.35);
}

.hero-stat-sep {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.1);
  flex-shrink: 0;
}

/* Right — image panel */
.hero-right {
  position: relative;
  background: #1a1917;
  overflow: hidden;
}

.hero-img-placeholder {
  width: 100%;
  height: 100%;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  color: #3a3a38;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.hero-badge-float {
  position: absolute;
  bottom: 2.5rem;
  left: -1.5rem;
  background: #fff;
  color: #111310;
  border-radius: 9999px;
  padding: 0.6rem 1.2rem;
  display: flex;
  align-items: center;
  gap: 0.55rem;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  white-space: nowrap;
}
.hero-badge-float svg { color: var(--color-primary); }

@media (max-width: 860px) {
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-right { display: none; }
  .hero-left { min-height: 100svh; }
}
</style>
