---
const reviews = [
  {
    text: "Santiago and his team completely transformed our kitchen. The cabinetry is absolutely beautiful and the attention to detail was incredible. They finished ahead of schedule and left the place spotless.",
    name: "Maria L.",
    location: "Miami, FL",
    initial: "M",
  },
  {
    text: "We hired Palacio Woodwork for a full bathroom renovation and couldn't be happier. Professional, clean, and the tile work is flawless. Our bathroom now looks like it belongs in a luxury hotel.",
    name: "James R.",
    location: "Fort Lauderdale, FL",
    initial: "J",
  },
  {
    text: "From the first meeting to the final walkthrough, everything was seamless. Santiago listened carefully to our vision and delivered exactly what we wanted — even better, actually. True craftsmen.",
    name: "Carlos & Ana M.",
    location: "Boca Raton, FL",
    initial: "C",
  },
];
---

<section class="section testimonials" id="testimonials">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Client Reviews</span>
      <h2>What Our Clients Say</h2>
    </div>

    <div class="reviews-grid">
      {reviews.map((r) => (
        <article class="review-card">
          <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote>"{r.text}"</blockquote>
          <div class="reviewer">
            <div class="reviewer-avatar" aria-hidden="true">{r.initial}</div>
            <div class="reviewer-info">
              <strong>{r.name}</strong>
              <span>{r.location}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.reviews-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: var(--space-5);
}

.review-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  transition: box-shadow var(--transition), transform var(--transition);
}

.review-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.stars {
  font-size: var(--text-lg);
  color: var(--color-gold);
  letter-spacing: 3px;
}

blockquote {
  font-size: var(--text-md);
  font-weight: 400;
  color: var(--color-text-muted);
  line-height: 1.65;
  font-style: italic;
  border: none;
  margin: 0;
  padding: 0;
  flex: 1;
}

.reviewer {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border);
}

.reviewer-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--text-base);
  flex-shrink: 0;
}

.reviewer-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.reviewer-info strong {
  font-size: var(--text-sm);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-text);
}

.reviewer-info span {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}
</style>
