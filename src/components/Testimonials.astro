---
import { testimonials } from '../data/site';
import { useContent } from '../i18n/content';
import { getLang, type Lang } from '../i18n/routes';

const lang: Lang = getLang(Astro.url.pathname);
const t = useContent(lang);

// Renders nothing until real client reviews are added to src/data/site.ts.
const items = testimonials[lang];
---

{items.length > 0 && (
  <section class="section section--paper">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.testimonials.eyebrow}</p>
        <h2 class="display-lg">{t.testimonials.heading}</h2>
      </div>

      <div class="quotes">
        {items.map((item, i) => (
          <figure class="quote" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <div class="quote__stars" aria-label="5/5">
              {[0, 1, 2, 3, 4].map(() => (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z" />
                </svg>
              ))}
            </div>
            <blockquote>{item.quote}</blockquote>
            <figcaption>
              <span class="quote__name">{item.name}</span>
              <span class="quote__loc">{item.location}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .quotes {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 720px)  { .quotes { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .quotes { grid-template-columns: repeat(3, 1fr); } }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    margin: 0;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    background: var(--sand);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .quote__stars { display: flex; gap: 3px; color: var(--oak); }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .quote figcaption {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .quote__name { font-weight: 600; font-size: 0.875rem; color: var(--ink); }
  .quote__loc  { font-size: 0.8125rem; color: var(--muted); }
</style>
