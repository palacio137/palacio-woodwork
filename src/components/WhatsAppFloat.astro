---
import { whatsappLink } from '../data/site';
import { useContent } from '../i18n/content';
import { getLang } from '../i18n/routes';

const lang = getLang(Astro.url.pathname);
const t = useContent(lang);
---

<a
  class="wa"
  href={whatsappLink(t.hero.whatsappMessage)}
  target="_blank"
  rel="noopener"
  aria-label={t.common.whatsapp}
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 8.24 8.25c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-1.98-1.22 7.45 7.45 0 0 1-1.37-1.71c-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.23.24-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.68-1.19.2-.58.2-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z" />
  </svg>
</a>

<style>
  .wa {
    position: fixed;
    right: 1rem;
    /* clears the mobile tab bar; sits on its own on desktop */
    bottom: calc(4.9rem + env(safe-area-inset-bottom, 0px));
    z-index: 85;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 8px 22px -6px rgba(37, 211, 102, 0.6),
                0 3px 10px rgba(10, 22, 18, 0.28);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .wa svg { width: 28px; height: 28px; }

  .wa:hover {
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 14px 30px -8px rgba(37, 211, 102, 0.68),
                0 4px 12px rgba(10, 22, 18, 0.3);
  }

  @media (min-width: 1000px) {
    .wa {
      right: 1.75rem;
      bottom: 1.75rem;
      width: 58px;
      height: 58px;
    }
    .wa svg { width: 31px; height: 31px; }
  }

  /* soft attention pulse, once the page has settled */
  @media (prefers-reduced-motion: no-preference) {
    .wa::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid #25d366;
      animation: waPulse 2.6s ease-out infinite;
      animation-delay: 3s;
      pointer-events: none;
    }
    @keyframes waPulse {
      0%   { opacity: 0.7; transform: scale(1); }
      70%  { opacity: 0; transform: scale(1.5); }
      100% { opacity: 0; transform: scale(1.5); }
    }
  }
</style>
