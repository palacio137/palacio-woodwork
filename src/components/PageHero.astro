---
import { useContent } from '../i18n/content';
import { getLang, type Lang } from '../i18n/routes';

interface Props {
  page: 'services' | 'projects' | 'about' | 'contact';
  image: string;
  /** Vertical focal point for the crop, e.g. '15%' to favour the top. */
  focus?: string;
  /**
   * 'soft' pulls the scrim back off the top-right so a detailed photo stays
   * readable, and leans on a left-side wash to hold contrast under the text.
   */
  overlay?: 'default' | 'soft';
}
const { page, image, focus = '55%', overlay = 'default' } = Astro.props;

const lang: Lang = getLang(Astro.url.pathname);
const copy = useContent(lang).pageHero[page];
---

<section class:list={['phero', { 'phero--soft': overlay === 'soft' }]}>
  <div class="phero__bg" style={`--focus:${focus}`}>
    <img src={image} alt="" fetchpriority="high" decoding="async" />
  </div>

  <div class="shell phero__inner">
    <p class="eyebrow on-dark" data-reveal>{copy.eyebrow}</p>
    <h1 class="display-lg phero__title" data-reveal style="--reveal-delay:80ms">{copy.title}</h1>
    <p class="lede phero__body" data-reveal style="--reveal-delay:160ms">{copy.body}</p>
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(340px, 46vh, 480px);
    background: var(--forest-900);
    overflow: hidden;
  }

  .phero__bg { position: absolute; inset: 0; z-index: -2; }
  .phero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--focus, 55%);
  }

  .phero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(14, 31, 25, 0.95) 8%, rgba(14, 31, 25, 0.66) 52%, rgba(14, 31, 25, 0.4) 100%);
  }

  /* Lets the photograph breathe top-right while a left-side wash keeps the
     headline well clear of WCAG AA. */
  .phero--soft::after {
    background:
      linear-gradient(to top,
        rgba(14, 31, 25, 0.92) 0%,
        rgba(14, 31, 25, 0.72) 30%,
        rgba(14, 31, 25, 0.3) 68%,
        rgba(14, 31, 25, 0.1) 100%),
      linear-gradient(to right,
        rgba(14, 31, 25, 0.62) 0%,
        rgba(14, 31, 25, 0.22) 45%,
        rgba(14, 31, 25, 0) 75%);
  }

  .phero__inner {
    padding-block: clamp(2.75rem, 6vw, 4rem);
    color: rgba(255, 255, 255, 0.76);
  }

  .phero__title { margin-top: 1.125rem; color: #fff; max-width: 20ch; }
  .phero__body { margin-top: 1.25rem; color: rgba(255, 255, 255, 0.74); }
</style>
