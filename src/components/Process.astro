---
import { process } from '../data/site';
---

<section class="section section--paper">
  <div class="shell">
    <div class="section-head section-head--split" data-reveal>
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="display-lg">Four steps, no surprises</h2>
      </div>
      <p class="lede">
        Most of the stress in a remodel comes from not knowing what happens next.
        This is the whole sequence.
      </p>
    </div>

    <ol class="steps">
      {process.map((step, i) => (
        <li class="step" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="step__num">{step.step}</span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__body">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    counter-reset: step;
  }
  @media (min-width: 680px)  { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .steps { grid-template-columns: repeat(4, 1fr); } }

  .step {
    position: relative;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--oak);
  }

  .step__num {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--oak-600);
  }

  .step__title {
    margin-top: 0.625rem;
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
  }

  .step__body {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
