---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { company, siteUrl } from '../data/site';
import { useContent } from '../i18n/content';
import { getLang, counterpart, type Lang } from '../i18n/routes';

interface Props {
  page: 'home' | 'services' | 'projects' | 'about' | 'contact' | 'notFound';
}

const { page } = Astro.props;

const lang: Lang = getLang(Astro.url.pathname);
const t = useContent(lang);
const meta = t.meta[page];

const here = Astro.url.pathname;
const enPath = counterpart(here, 'en');
const esPath = counterpart(here, 'es');
const canonical = new URL(lang === 'en' ? enPath : esPath, siteUrl).href;

// --------------------------------------------------------------------------
// Structured data. Emitted as one @graph so the business, the site, the page
// and its breadcrumbs cross-reference each other by @id rather than repeating.
// --------------------------------------------------------------------------

const businessId = `${siteUrl}/#business`;
const websiteId = `${siteUrl}/#website`;

const business = {
  '@type': ['GeneralContractor', 'HomeAndConstructionBusiness'],
  '@id': businessId,
  name: company.legalName,
  alternateName: company.name,
  slogan: t.footer.tagline,
  description: t.meta.home.description,
  url: siteUrl,
  telephone: `+1${company.whatsapp.slice(1)}`,
  email: company.email,
  image: `${siteUrl}/img/og-cover.jpg`,
  logo: { '@type': 'ImageObject', url: `${siteUrl}/logo.jpg` },
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: company.city,
    addressRegion: company.state,
    addressCountry: 'US',
  },
  areaServed: t.areas.list.map((n) => ({ '@type': 'City', name: n })),
  knowsLanguage: ['en', 'es'],
  sameAs: [company.instagram, company.facebook],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t.services.eyebrow,
    itemListElement: t.services.items.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.short },
    })),
  },
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: siteUrl,
  name: company.legalName,
  inLanguage: lang,
  publisher: { '@id': businessId },
};

const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical}#page`,
  url: canonical,
  name: meta.title,
  description: meta.description,
  inLanguage: lang,
  isPartOf: { '@id': websiteId },
  about: { '@id': businessId },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${siteUrl}/img/og-cover.jpg` },
};

// Breadcrumbs on every page but the home page.
const homeUrl = new URL(lang === 'en' ? '/' : '/es/', siteUrl).href;
const breadcrumbs =
  page === 'home' || page === 'notFound'
    ? null
    : {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t.common.home, item: homeUrl },
          { '@type': 'ListItem', position: 2, name: meta.title.split('|')[0].trim(), item: canonical },
        ],
      };

// The FAQ block is rendered on the home, services and contact pages; declaring
// it lets those answers surface directly in search results.
const faqPage = ['home', 'services', 'contact'].includes(page)
  ? {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: t.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [business, website, webPage, breadcrumbs, faqPage].filter(Boolean),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).href} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, siteUrl).href} />

    <link rel="icon" type="image/png" href="/img/mark.png" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="theme-color" content="#0E1F19" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.legalName} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/img/og-cover.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/img/og-cover.jpg`} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Language routing: send Spanish-speaking visitors to /es/ on first
         visit, but never override an explicit choice made with the switcher. -->
    <script is:inline define:vars={{ lang, enPath, esPath }}>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('pw-lang');
        } catch (_) {}

        if (lang === 'en') {
          const prefersEs = (navigator.language || '').toLowerCase().startsWith('es');
          if (stored === 'es' || (!stored && prefersEs)) location.replace(esPath);
        } else if (stored === 'en') {
          location.replace(enPath);
        }
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a href="#main" class="visually-hidden">{t.common.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <MobileTabBar />

    <script is:inline>
      (() => {
        const items = document.querySelectorAll('[data-reveal]');
        if (!items.length) return;
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

<style is:global>
  /* leave room for the fixed mobile tab bar */
  body { padding-bottom: calc(4.25rem + env(safe-area-inset-bottom, 0px)); }
  @media (min-width: 1000px) { body { padding-bottom: 0; } }
</style>
